{
  "ConnectionStrings": {
    "MeasurementDb": "Host=localhost;Port=5432;Database=measurement_db;Username=postgres;Password=postgres;Command Timeout=30"
  },
  "ImporterOptions": {
    "IncomingFolder": "C:\\MeasurementData\\incoming",
    "BackupFolder": "C:\\MeasurementData\\backup",
    "ProcessedFolder": "C:\\MeasurementData\\processed",
    "ErrorFolder": "C:\\MeasurementData\\error",
    "DefaultRecipeName": "DEFAULT_RECIPE",
    "DefaultEquipmentId": "EQ-01",
    "PollingIntervalSeconds": 5,
    "FileSearchPattern": "*.csv",
    "MinFileAgeMilliseconds": 1000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/measurement-importer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
